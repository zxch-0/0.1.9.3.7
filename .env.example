# ---------------------------------------------------------------------------
# Copy to ".env" for local runs (python-dotenv loads it automatically).
# On Render, put the same keys in the dashboard's Environment tab instead.
# Every value below is OPTIONAL except DISCORD_TOKEN.
# ---------------------------------------------------------------------------

# REQUIRED. Discord Developer Portal > your application > Bot > Reset Token.
# (DISCORD_BOT_TOKEN is accepted too, for panels that use that name.)
DISCORD_TOKEN=paste-your-bot-token-here

# Comma or space separated user IDs that receive the forms in DM.
# Discord > Settings > Advanced > Developer mode ON, then right-click a user > Copy user ID.
ADMIN_USER_IDS=100000000000000001

# Optional. Your server ID -> slash commands appear instantly on that server.
# Without it, registration is global and can take up to 1 hour the first time.
GUILD_ID=

# ------------------------------------------------------------------ appearance
FORM_TITLE=Intake form
FORM_HEADLINE=Need something handled?
# \n is allowed, Render's dashboard has no multiline field.
FORM_BLURB=Press **START**, paste the info you have, drop your Discord ID.\nAn admin picks it up and DMs you the results.
FORM_START_LABEL=START
FORM_START_EMOJI=▶️
FORM_BANNER_URL=
EMBED_COLOUR=5865F2

# ----------------------------------------------------------------- form fields
FORM_FIELD_1_LABEL=Infos you got
FORM_FIELD_1_PLACEHOLDER=Everything you have: what you need, links, names, deadlines…
FORM_FIELD_2_LABEL=Your Discord ID to send u results
FORM_FIELD_2_PLACEHOLDER=123456789012345678  or  leave empty to use your own ID
FORM_MAX_INFOS=2000
FORM_MIN_INFOS=3
FORM_MAX_ID_CHARS=60
FORM_MODAL_TIMEOUT_MINUTES=15

# Multi-page form (optional, 1-5 pages). Page 1 is the two boxes above.
# Extra boxes per page: key:Label:short|long:required:max_length:placeholder  (separate with ;)
FORM_PAGES=1
# FORM_PAGE2=Proof
# FORM_FIELDS_P2=proof_link:Link to your proof:short:no:250;notes:Any other notes:long:no:1000

# -------------------------------------------------------------------- behaviour
FORM_COOLDOWN_SECONDS=30
NOTIFY_ON_HANDLED=true
SYNC_ON_START=true
PERSIST_STATE=true
DATA_DIR=data
MAX_STORED_SUBMISSIONS=200
LOG_LEVEL=info

# ------------------------------------------------- keep-alive / health endpoint
HEALTH_ENABLED=true
PORT=10000
# Optional: only needed for POST /admin/ping (UptimeRobot does not use it).
PING_TOKEN=
